# Copy to .env and fill in real values. Never commit .env.

# Port the API listens on. The frontend's VITE_API_BASE_URL should
# point here in local dev (see ../frontend/.env.example).
PORT=4000

NODE_ENV=development

# MongoDB Atlas connection string (free cluster is fine).
# Atlas dashboard → Connect → Drivers → copy the string, then swap in
# your database user's password and pick a database name, e.g.:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devclash?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWTs. Use a long, random string in every
# environment — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API.
# Add your deployed Vercel URL here once the frontend is deployed
# (Stage A14 / Stage L8), e.g.:
# CORS_ORIGIN=http://localhost:5173,https://devclash.vercel.app
CORS_ORIGIN=http://localhost:5173
