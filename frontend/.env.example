# Base URL of the DevClash backend API (see ../backend).
# Copy this file to .env and adjust if your backend runs elsewhere.
#
# Local dev matches ../backend/.env.example's default PORT=4000:
VITE_API_BASE_URL=http://localhost:4000

# Once the backend is deployed (Stage L8), point this at that URL
# instead, e.g. VITE_API_BASE_URL=https://devclash-api.onrender.com
